---
import { CONTACT_INFO, getWhatsAppUrl } from "@/config/contact";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navLinks = [
  { href: `${base}/menu`, label: "Menú" },
  { href: `${base}/gallery`, label: "Galería" },
  { href: `${base}/about`, label: "Nosotros" },
  { href: `${base}/contact`, label: "Contacto" },
];
const whatsappUrl = getWhatsAppUrl(CONTACT_INFO.whatsapp.orderMessage);
---

<!-- Desktop — Floating Glass Pill -->
<nav
  id="desktop-nav"
  class="fixed left-1/2 top-6 z-50 hidden -translate-x-1/2 items-center gap-1 rounded-full border border-white/10 px-2 py-2 backdrop-blur-md transition-all duration-500 md:flex bg-black/40"
  role="navigation"
  aria-label="Navegación principal"
>
  <a
    href={base || "/"}
    class="mr-3 flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-bold text-white transition-colors hover:text-lroma-red"
  >
    L'ROMA
  </a>

  <div class="h-5 w-px bg-white/10"></div>

  {navLinks.map((link) => (
    <a
      href={link.href}
      class="rounded-full px-4 py-1.5 text-sm font-medium text-white/80 transition-all duration-300 hover:bg-white/10 hover:text-white"
    >
      {link.label}
    </a>
  ))}

  <div class="h-5 w-px bg-white/10"></div>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-1.5 rounded-full bg-lroma-red px-4 py-1.5 text-sm font-semibold text-white transition-all duration-300 hover:bg-lroma-red/90 hover:shadow-lg hover:shadow-lroma-red/20"
  >
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-icon="inline-start">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </svg>
    WhatsApp
  </a>
</nav>

<!-- Mobile — Hamburger button -->
<div class="fixed right-4 top-4 z-50 md:hidden">
  <button
    id="mobile-menu-btn"
    class="rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-white p-2.5 hover:bg-black/60 transition-colors duration-300"
    aria-label="Abrir menú"
  >
    <svg id="menu-icon-bars" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
    <svg id="menu-icon-x" class="size-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 6 6 18M6 6l12 12"/>
    </svg>
  </button>
</div>

<!-- Mobile — Full-screen overlay -->
<div
  id="mobile-overlay"
  class="fixed inset-0 z-40 flex flex-col items-center justify-center gap-6 bg-black/90 backdrop-blur-xl opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
>
  <nav
    class="flex flex-col items-center gap-6"
    role="navigation"
    aria-label="Navegación móvil"
  >
    <a href={base || "/"} class="mb-8 text-2xl font-bold text-white">
      L'ROMA
    </a>

    {navLinks.map((link) => (
      <a
        href={link.href}
        class="text-xl font-light text-white/70 transition-colors hover:text-white"
      >
        {link.label}
      </a>
    ))}

    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-lroma-red px-8 py-3 text-base font-semibold text-white shadow-lg shadow-lroma-red/20 transition-all hover:bg-lroma-red/90"
    >
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
      </svg>
      Pedir por WhatsApp
    </a>
  </nav>
</div>

<script>
  function setupNav() {
    const nav = document.getElementById('desktop-nav');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const overlay = document.getElementById('mobile-overlay');
    const barsIcon = document.getElementById('menu-icon-bars');
    const xIcon = document.getElementById('menu-icon-x');

    let menuOpen = false;

    function closeMenu() {
      menuOpen = false;
      overlay?.classList.add('opacity-0', 'pointer-events-none');
      overlay?.classList.remove('opacity-100');
      barsIcon?.classList.remove('hidden');
      xIcon?.classList.add('hidden');
      menuBtn?.setAttribute('aria-label', 'Abrir menú');
    }

    function openMenu() {
      menuOpen = true;
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
      overlay?.classList.add('opacity-100');
      barsIcon?.classList.add('hidden');
      xIcon?.classList.remove('hidden');
      menuBtn?.setAttribute('aria-label', 'Cerrar menú');
    }

    function updateScroll() {
      if (!nav) return;
      if (window.scrollY > 20) {
        nav.classList.remove('bg-black/40');
        nav.classList.add('bg-black/60', 'shadow-lg', 'shadow-black/20');
      } else {
        nav.classList.add('bg-black/40');
        nav.classList.remove('bg-black/60', 'shadow-lg', 'shadow-black/20');
      }
    }

    updateScroll();
    window.removeEventListener('scroll', updateScroll);
    window.addEventListener('scroll', updateScroll, { passive: true });

    menuBtn?.addEventListener('click', () => {
      if (menuOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) {
        closeMenu();
      }
    });

    overlay?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => closeMenu());
    });
  }

  document.addEventListener('astro:page-load', setupNav);
</script>
