---
// ContactCard — Double-Bezel glass card centered on page
// Phone (prominent, tappable), address with maps link, hours table,
// WhatsApp CTA, social media links
import { Phone, MapPin, Clock, MessageCircle } from "lucide-react";
import GsapReveal from "@/components/global/GsapReveal";
import { CONTACT_INFO, getWhatsAppUrl } from "@/config/contact";

const whatsappUrl = getWhatsAppUrl(CONTACT_INFO.whatsapp.orderMessage);
---

<section class="px-6 py-24 md:py-36" aria-labelledby="contact-heading">
  <div class="mx-auto max-w-3xl">
    <!-- ============================================
         Section header
         ============================================ -->
    <div class="mb-16 text-center md:mb-20">
      <span
        class="inline-block text-xs font-semibold tracking-[0.25em] text-lroma-gold uppercase"
      >
        Contacto
      </span>
      <h1
        id="contact-heading"
        class="mt-4 font-heading text-[clamp(2rem,5vw,3.5rem)] leading-tight text-white"
      >
        Contactanos
      </h1>
      <div
        class="mx-auto mt-5 h-px w-16 bg-gradient-to-r from-transparent via-lroma-gold/40 to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>

    <!-- ============================================
         Double-Bezel glass card
         Outer: gradient border, Inner: backdrop-blur content
         ============================================ -->
    <GsapReveal direction="up" duration={0.8} blur={true}>
      <div
        class="overflow-hidden rounded-3xl border border-white/10 bg-black/40 shadow-2xl backdrop-blur-md"
        role="region"
        aria-label="Información de contacto"
      >
        <!-- Content -->
        <div class="flex flex-col gap-8 p-8 md:p-12">
          <!-- Phone — prominent, large -->
          <div class="flex items-center gap-4">
            <div
              class="flex size-12 shrink-0 items-center justify-center rounded-full bg-lroma-gold/10 text-lroma-gold"
            >
              <Phone className="size-5" aria-hidden="true" />
            </div>
            <div>
              <p class="text-sm text-white/40">Teléfono</p>
              <a
                href={CONTACT_INFO.phone.telHref}
                class="font-heading text-2xl font-bold text-white transition-colors hover:text-lroma-gold md:text-3xl"
              >
                {CONTACT_INFO.phone.display}
              </a>
            </div>
          </div>

          <!-- Glass divider -->
          <div
            class="h-px bg-gradient-to-r from-transparent via-white/8 to-transparent"
            aria-hidden="true"
          >
          </div>

          <!-- Address + Map link -->
          <div class="flex items-center gap-4">
            <div
              class="flex size-12 shrink-0 items-center justify-center rounded-full bg-lroma-gold/10 text-lroma-gold"
            >
              <MapPin className="size-5" aria-hidden="true" />
            </div>
            <div>
              <p class="text-sm text-white/40">Dirección</p>
              <p class="text-lg leading-relaxed text-white/80">
                {CONTACT_INFO.address.street}
                <br />
                <span class="text-white/50">{CONTACT_INFO.address.city}, {CONTACT_INFO.address.state}</span>
              </p>
              <a
                href={CONTACT_INFO.address.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 inline-block text-sm text-lroma-gold transition-colors hover:text-lroma-gold/80"
              >
                Ver en Google Maps →
              </a>
            </div>
          </div>

          <!-- Glass divider -->
          <div
            class="h-px bg-gradient-to-r from-transparent via-white/8 to-transparent"
            aria-hidden="true"
          >
          </div>

          <!-- Hours table -->
          <div class="flex items-start gap-4">
            <div
              class="flex size-12 shrink-0 items-center justify-center rounded-full bg-lroma-gold/10 text-lroma-gold"
            >
              <Clock className="size-5" aria-hidden="true" />
            </div>
            <div class="w-full">
              <p class="text-sm text-white/40">Horarios</p>
              <table class="mt-2 w-full text-sm">
                <tbody>
                  {
                    CONTACT_INFO.hours.map((row) => (
                      <tr class="border-b border-white/5 last:border-b-0">
                        <td class="py-2.5 pr-4 text-white/70">{row.day}</td>
                        <td class="py-2.5 text-right font-medium text-white/90">
                          {row.time}
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>

          <!-- Glass divider -->
          <div
            class="h-px bg-gradient-to-r from-transparent via-white/8 to-transparent"
            aria-hidden="true"
          >
          </div>

          <!-- WhatsApp CTA + Social -->
          <div
            class="flex flex-col items-center gap-5 sm:flex-row sm:justify-between"
          >
            <!-- WhatsApp red pill -->
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#E73134] px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-lroma-red/25 transition-all duration-300 hover:bg-[#cc1f22] hover:shadow-xl hover:shadow-lroma-red/35 sm:w-auto"
            >
              <MessageCircle className="size-4" />
              Contactanos por WhatsApp
            </a>

            <!-- Social icons -->
            <div class="flex gap-4">
              <a
                href={CONTACT_INFO.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-white/10 p-2.5 text-white/50 transition-all hover:border-white/30 hover:text-white"
                aria-label="Instagram"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                  ></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              </a>
              <a
                href={CONTACT_INFO.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-white/10 p-2.5 text-white/50 transition-all hover:border-white/30 hover:text-white"
                aria-label="Facebook"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path
                    d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                  ></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </GsapReveal>
  </div>
</section>
