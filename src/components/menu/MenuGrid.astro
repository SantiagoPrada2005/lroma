---
import { getUnsplashUrl } from "@/lib/images";

export interface MenuItemData {
  id: string;
  name: string;
  description?: string;
  price: number;
  category: string;
  image: string;
  featured: boolean;
}

interface Props {
  items: MenuItemData[];
}

const { items } = Astro.props;

const CATEGORY_LABELS: Record<string, string> = {
  pizzas: "Pizzas",
  burgers: "Hamburguesas",
  hots: "Hot Dogs",
  sandwiches: "Sandwiches",
  pastas: "Pastas",
  grill: "Parrilla",
  picadas: "Picadas",
  alitas: "Alitas",
  drinks: "Bebidas",
};

// Group items by category, preserving order of first appearance
const categoryOrder: string[] = [];
const byCategory = new Map<string, MenuItemData[]>();
for (const item of items) {
  if (!byCategory.has(item.category)) {
    byCategory.set(item.category, []);
    categoryOrder.push(item.category);
  }
  byCategory.get(item.category)!.push(item);
}

function formatPrice(price: number): string {
  return `$${price.toLocaleString("es-AR")}`;
}
---

<section
  data-menu-grid
  class="relative z-10 px-6 pt-8 pb-32 md:pt-12 md:pb-40 scroll-mt-28 md:scroll-mt-36"
  aria-label="Menú"
>
  <div class="mx-auto max-w-7xl">
    {
      categoryOrder.map((cat, idx) => {
        const catItems = byCategory.get(cat)!;
        const label = CATEGORY_LABELS[cat] ?? cat;

        return (
          <section
            data-category-section={cat}
            class:list={[
              "scroll-mt-28 md:scroll-mt-36",
              idx > 0 ? "mt-16 md:mt-20" : "",
            ]}
          >
            {/* Section eyebrow */}
            <div class="mb-8 flex items-center gap-3 md:mb-10">
              <span class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent" />
              <span class="text-[11px] font-semibold tracking-[0.25em] text-white/25 uppercase shrink-0">
                {label}
              </span>
              <span class="h-px flex-1 bg-gradient-to-r from-transparent via-white/[0.08] to-transparent" />
            </div>

            {/* Bento grid — 3 cols desktop, 1 col mobile */}
            <div class="grid gap-4 md:grid-cols-3 md:gap-5 auto-rows-auto">
              {catItems.map((item) => (
                <article
                  data-menu-card
                  class:list={[
                    "group flex flex-col contain-content",
                    { "md:col-span-2": item.featured },
                  ]}
                  style="content-visibility: auto; contain-intrinsic-size: auto 320px;"
                >
                  <div class="flex flex-1 flex-col overflow-hidden rounded-3xl p-[1px] bg-gradient-to-br from-white/[0.07] via-white/[0.04] to-white/[0.02] transition-shadow duration-300 group-hover:shadow-[0_0_30px_rgba(231,49,52,0.06)]">
                    <div class="flex flex-1 flex-col overflow-hidden rounded-[calc(1.5rem-1px)] bg-neutral-900/90 border border-white/[0.06] transition-transform duration-300 group-hover:-translate-y-1">
                      {/* Image */}
                      <div class="relative aspect-[4/3] overflow-hidden">
                        <img
                          src={getUnsplashUrl(item.image, 400)}
                          alt={item.name}
                          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                          loading="lazy"
                          decoding="async"
                          width="400"
                          height="300"
                        />
                        <div
                          class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"
                          aria-hidden="true"
                        />

                        {item.featured && (
                          <span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-lroma-gold/90 px-2.5 py-1 text-[10px] font-bold tracking-wider text-black uppercase">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-2.5"><path d="M12 4v16"/><path d="M8 8h8"/><path d="M16 12h-8"/></svg>
                            Destacado
                          </span>
                        )}
                      </div>

                      {/* Content */}
                      <div class="flex flex-1 flex-col p-5">
                        <h3 class="font-heading text-lg font-bold text-white/90 leading-snug">
                          {item.name}
                        </h3>
                        {item.description && (
                          <p class="mt-1.5 flex-1 text-[13px] leading-relaxed text-white/35 line-clamp-2">
                            {item.description}
                          </p>
                        )}
                        <div class="mt-4 flex items-center justify-between">
                          <span class="font-heading text-lg font-semibold text-lroma-gold">
                            {formatPrice(item.price)}
                          </span>

                          {/* Add button — React island hooks into this via event delegation */}
                          <button
                            type="button"
                            data-add-btn={item.id}
                            data-item-name={item.name}
                            data-item-price={String(item.price)}
                            class="menu-add-btn group/btn flex items-center gap-1.5 rounded-full border border-white/[0.08] bg-white/[0.04] px-3.5 py-1.5 text-xs font-medium text-white/70 transition-all duration-300 hover:border-lroma-red/30 hover:bg-lroma-red/10 hover:text-white"
                            aria-label={`Agregar ${item.name}`}
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 transition-transform duration-300 group-hover/btn:rotate-90"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                            Agregar
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</section>

<script>
  // Reveal animation on scroll — Lightweight transform & opacity only (GPU accelerated)
  const cards = document.querySelectorAll<HTMLElement>("[data-menu-card]");

  if ("IntersectionObserver" in window) {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
            revealObserver.unobserve(el);
          }
        }
      },
      { rootMargin: "0px 0px -40px 0px", threshold: 0.1 },
    );

    cards.forEach((card) => {
      card.style.opacity = "0";
      card.style.transform = "translateY(24px)";
      card.style.transition = "opacity 0.4s ease-out, transform 0.4s ease-out";
      revealObserver.observe(card);
    });
  } else {
    cards.forEach((card) => {
      card.style.opacity = "1";
    });
  }
</script>
