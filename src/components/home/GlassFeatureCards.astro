---
// GlassFeatureCards — Editorial bento grid with glass cards
// Asymmetrical layout: 1 large hero card (2x2) + 3 smaller cards around it
// Magazine editorial aesthetic — images bleed, typography overlay, subtle glass
import { MessageCircle } from "lucide-react";
import GsapReveal from "@/components/global/GsapReveal";

interface DishItem {
  name: string;
  description: string;
  price: string;
  image: string;
  whatsappMsg: string;
  featured: boolean;
}

const dishes: DishItem[] = [
  {
    name: "Pizza Margherita",
    description:
      "Mozzarella fresca, albahaca, tomate San Marzano y aceite de oliva extra virgen.",
    price: "$12.000",
    image:
      "https://images.unsplash.com/photo-1574071318508-1cdbab80d002?w=800&fm=webp&fit=crop&q=80",
    whatsappMsg: "Hola%20L'Roma!%20Quiero%20pedir%20una%20Pizza%20Margherita",
    featured: true,
  },
  {
    name: "Baby Beef",
    description:
      "Corte premium de 400g, papas rústicas y chimichurri de la casa.",
    price: "$18.500",
    image:
      "https://images.unsplash.com/photo-1600891964092-4316c288032e?w=800&fm=webp&fit=crop&q=80",
    whatsappMsg: "Hola%20L'Roma!%20Quiero%20pedir%20un%20Baby%20Beef",
    featured: false,
  },
  {
    name: "Pasta Carbonara",
    description:
      "Fettuccine al huevo, panceta crocante, yema, pecorino y pimienta negra.",
    price: "$14.000",
    image:
      "https://images.unsplash.com/photo-1612874742237-6526221588e3?w=800&fm=webp&fit=crop&q=80",
    whatsappMsg:
      "Hola%20L'Roma!%20Quiero%20pedir%20una%20Pasta%20Carbonara",
    featured: false,
  },
  {
    name: "Hamburguesa L'Roma",
    description:
      "Blend de carne 200g, cheddar ahumado, panceta, cebolla caramelizada y pan brioche.",
    price: "$13.500",
    image:
      "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=800&fm=webp&fit=crop&q=80",
    whatsappMsg:
      "Hola%20L'Roma!%20Quiero%20pedir%20una%20Hamburguesa%20L'Roma",
    featured: false,
  },
];

// Separate featured dish from the rest
const featured = dishes.find((d) => d.featured) || dishes[0];
const others = dishes.filter((d) => !d.featured);
---

<section class="px-6 py-24 md:py-36" aria-labelledby="featured-heading">
  <div class="mx-auto max-w-7xl">
    <!-- ============================================
         Section header — editorial
         ============================================ -->
    <div class="mb-16 md:mb-20">
      <span
        class="inline-block text-xs font-semibold tracking-[0.25em] text-lroma-gold uppercase"
      >
        Destacados
      </span>
      <h2
        id="featured-heading"
        class="mt-4 font-heading text-[clamp(2rem,5vw,3.5rem)] leading-tight text-white md:max-w-md"
      >
        Lo mejor de nuestra cocina
      </h2>
      <div
        class="mt-5 h-px w-16 bg-gradient-to-r from-lroma-gold/50 to-transparent"
        aria-hidden="true"
      ></div>
    </div>

    <!-- ============================================
         Editorial bento grid
         Mobile: single column stack
         Desktop: 3-col with 1 large card spanning 2 cols + 2 rows
         ============================================ -->
    <div
      class="grid gap-4 md:grid-cols-3 md:gap-5"
      role="list"
      aria-label="Platos destacados"
    >
      <!-- Featured large card (spans 2 cols x 2 rows on desktop) -->
      <GsapReveal direction="up" duration={0.8}>
        <article
          role="listitem"
          class="group relative overflow-hidden rounded-3xl border border-white/5 bg-black/30 backdrop-blur-sm md:col-span-2 md:row-span-2"
        >
          <!-- Full-bleed image -->
          <div class="relative aspect-[4/3] overflow-hidden md:aspect-auto md:h-full">
            <img
              src={featured.image}
              alt={featured.name}
              class="h-full w-full object-cover transition-transform duration-1000 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
            <!-- Gradient overlay for text legibility -->
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"
              aria-hidden="true"
            ></div>

            <!-- Text overlay at bottom -->
            <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
              <span class="text-[11px] font-semibold tracking-[0.2em] text-lroma-gold uppercase">
                Plato estrella
              </span>
              <h3 class="mt-2 font-heading text-2xl font-bold text-white md:text-3xl">
                {featured.name}
              </h3>
              <p class="mt-2 max-w-md text-sm leading-relaxed text-white/60">
                {featured.description}
              </p>
              <div class="mt-4 flex items-center justify-between">
                <span class="font-heading text-xl font-bold text-lroma-gold">
                  {featured.price}
                </span>
                <a
                  href={`https://wa.me/549XXXXXXXXX?text=${featured.whatsappMsg}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full border border-lroma-red/30 px-5 py-2 text-xs font-medium text-white transition-all duration-300 hover:border-lroma-red/50 hover:bg-lroma-red/15"
                  aria-label={`Pedir ${featured.name} por WhatsApp`}
                >
                  <MessageCircle className="size-3.5" />
                  Pedir
                </a>
              </div>
            </div>
          </div>
        </article>
      </GsapReveal>

      <!-- 3 regular cards in remaining grid cells -->
      {others.map((dish, i) => (
        <GsapReveal direction="up" delay={0.15 + i * 0.1} duration={0.7}>
          <article
            role="listitem"
            class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/5 bg-black/25 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:border-white/10 hover:bg-black/35"
          >
            <!-- Image -->
            <div class="relative aspect-[16/10] overflow-hidden">
              <img
                src={dish.image}
                alt={dish.name}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                aria-hidden="true"
              ></div>
            </div>

            <!-- Content -->
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-heading text-lg font-bold text-white">
                {dish.name}
              </h3>
              <p class="mt-1.5 flex-1 text-sm leading-relaxed text-white/50">
                {dish.description}
              </p>
              <div class="mt-4 flex items-center justify-between">
                <span class="font-heading text-lg font-bold text-lroma-gold">
                  {dish.price}
                </span>
                <a
                  href={`https://wa.me/549XXXXXXXXX?text=${dish.whatsappMsg}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 rounded-full border border-lroma-red/20 px-3.5 py-1.5 text-xs font-medium text-lroma-red transition-all duration-300 hover:border-lroma-red/40 hover:bg-lroma-red/10"
                  aria-label={`Pedir ${dish.name} por WhatsApp`}
                >
                  <MessageCircle className="size-3" />
                  Pedir
                </a>
              </div>
            </div>
          </article>
        </GsapReveal>
      ))}
    </div>

    <!-- CTA: Ver Menú Completo -->
    <div class="mt-16 text-center">
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/menu`}
        class="inline-flex items-center gap-2 rounded-full border border-white/15 px-10 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition-all duration-300 hover:border-white/30 hover:bg-white/8"
      >
        Ver Menú Completo
        <span aria-hidden="true" class="text-white/40">&rarr;</span>
      </a>
    </div>
  </div>
</section>
