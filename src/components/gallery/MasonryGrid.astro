---
// MasonryGrid — Bento grid of food photography
// Mixed aspect ratios, lazy loading, blur-up placeholders
// Click opens lightbox via data-gallery-image
import GsapReveal from "@/components/global/GsapReveal";
import { SITE_IMAGES } from "@/config/images";

const images = SITE_IMAGES.gallery;
---

<section
  class="px-6 py-24 md:py-36"
  aria-labelledby="gallery-heading"
>
  <div class="mx-auto max-w-7xl">
    <!-- ============================================
         Section header — editorial
         ============================================ -->
    <div class="mb-16 md:mb-20">
      <span
        class="inline-block text-xs font-semibold tracking-[0.25em] text-lroma-gold uppercase"
      >
        Galería
      </span>
      <h1
        id="gallery-heading"
        class="mt-4 font-heading text-[clamp(2rem,5vw,3.5rem)] leading-tight text-white md:max-w-md"
      >
        Nuestra cocina
      </h1>
      <div
        class="mt-5 h-px w-16 bg-gradient-to-r from-lroma-gold/50 to-transparent"
        aria-hidden="true"
      ></div>
    </div>

    <!-- ============================================
         Bento / Masonry grid
         Mobile: 2-column grid, tall cards
         Desktop: 4-column with varied spans
         ============================================ -->
    <div
      class="grid auto-rows-[200px] gap-3 md:auto-rows-[240px] md:grid-cols-4 md:gap-4"
      role="list"
      aria-label="Galería de imágenes"
    >
      {images.map((img, i) => (
        <GsapReveal
          direction="up"
          delay={0.05 * i}
          duration={0.7}
          blur={true}
        >
          <button
            role="listitem"
            data-gallery-image={i.toString()}
            aria-label={`Ver ${img.alt}`}
            class={`group relative w-full overflow-hidden rounded-2xl border border-white/5 bg-black/30 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:border-white/10 hover:shadow-2xl focus:outline-none focus:ring-2 focus:ring-lroma-gold/50 ${img.span} ${img.aspect}`}
          >
            <!-- Blur-up placeholder (low-res base64) + full image -->
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-all duration-700 group-hover:scale-105 group-hover:brightness-110"
            />

            <!-- Hover overlay -->
            <div
              class="absolute inset-0 flex items-end bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
              aria-hidden="true"
            >
              <span class="p-4 text-xs font-medium text-white/80">
                Ampliar
              </span>
            </div>
          </button>
        </GsapReveal>
      ))}
    </div>
  </div>
</section>

<!-- ============================================
     Lightbox JS — click handler broadcasts to
     GalleryLightbox React island via custom event
     ============================================ -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const galleryButtons = document.querySelectorAll<HTMLButtonElement>(
      "[data-gallery-image]"
    );

    galleryButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const index = parseInt(btn.dataset.galleryImage || "0", 10);
        window.dispatchEvent(
          new CustomEvent("gallery:open", { detail: { index } })
        );
      });
    });
  });
</script>
