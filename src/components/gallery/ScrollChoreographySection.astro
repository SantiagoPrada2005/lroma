---
// ScrollChoreographySection — wraps 21st.dev ScrollChoreography
// 4-image diagonal scroll choreography (300vh, 3 phases)
// using framer-motion useScroll / useTransform
import ScrollChoreography from "@/components/ui/scroll-choreography";
import { SITE_IMAGES } from "@/config/images";
---

<section
  class="bg-lroma-black px-6 py-12 md:py-24"
  aria-labelledby="cocina-heading"
>
  <div class="mx-auto mb-10 max-w-7xl md:mb-16">
    <span
      class="inline-block text-xs font-semibold tracking-[0.25em] text-lroma-gold uppercase"
    >
      Nuestra cocina
    </span>
    <h2
      id="cocina-heading"
      class="mt-4 font-heading text-[clamp(1.75rem,4vw,3rem)] leading-tight text-white"
    >
      El arte en cada plato
    </h2>
    <div
      class="mt-4 h-px w-16 bg-gradient-to-r from-lroma-gold/50 to-transparent"
      aria-hidden="true"
    ></div>
  </div>

  <ScrollChoreography
    client:load
    images={SITE_IMAGES.scrollChoreography}
  />
</section>
