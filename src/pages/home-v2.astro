---
// Home v2 — ScrollMorphHero variant
// Interactive 3D morphing hero with food photography carousel
import BaseLayout from "@/layouts/BaseLayout.astro";
import ScrollMorphHero from "@/components/ui/scroll-morph-hero";
import StatsCounter from "@/components/home/StatsCounter";
import ReservationCTA from "@/components/home/ReservationCTA.astro";
---

<BaseLayout
  title="Inicio"
  description="L'Roma Pizza & Grill — Pizza artesanal, parrilla y cocina de autor. Descubrí una experiencia gastronómica única."
>
  <div class="h-screen">
    <ScrollMorphHero client:load />
  </div>
  <StatsCounter client:visible />
  <ReservationCTA />
</BaseLayout>
