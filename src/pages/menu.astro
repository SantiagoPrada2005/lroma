---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MenuHero from "@/components/menu/MenuHero.astro";
import MenuContent from "@/components/menu/MenuContent";
import { getCollection } from "astro:content";

const menuItems = await getCollection("menu");
const serializedItems = menuItems.map((item) => ({
  id: item.id,
  name: item.data.name,
  description: item.data.description,
  price: item.data.price,
  category: item.data.category,
  image: item.data.image,
  featured: item.data.featured,
}));

const featuredItem = serializedItems.find((i) => i.featured);
---

<BaseLayout
  title="Menú"
  description="Explorá nuestro menú — pizzas artesanales, parrilla, pastas y más. Elegí tus platos y pedí directo por WhatsApp."
>
  <MenuHero featuredItem={featuredItem} />
  <MenuContent items={serializedItems} client:visible />
</BaseLayout>
