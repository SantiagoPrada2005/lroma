---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MenuHero from "@/components/menu/MenuHero.astro";
import CategoryNav from "@/components/menu/CategoryNav.astro";
import MenuGrid from "@/components/menu/MenuGrid.astro";
import MenuOrderPanel from "@/components/menu/MenuOrderPanel";
import { getCollection } from "astro:content";

const menuItems = await getCollection("menu");
const serializedItems = menuItems.map((item) => ({
  id: item.id,
  name: item.data.name,
  description: item.data.description,
  price: item.data.price,
  category: item.data.category,
  image: item.data.image,
  featured: item.data.featured,
}));

const featuredItem = serializedItems.find((i) => i.featured);

// Lightweight order items — only what the interactive panel needs
const orderItems = serializedItems.map((item) => ({
  id: item.id,
  name: item.name,
  price: item.price,
}));
---

<BaseLayout
  title="Menú"
  description="Explorá nuestro menú — pizzas artesanales, parrilla, pastas y más. Elegí tus platos y pedí directo por WhatsApp."
>
  <MenuHero featuredItem={featuredItem} />
  <CategoryNav items={serializedItems} />
  <MenuGrid items={serializedItems} />
  <MenuOrderPanel items={orderItems} client:idle />
</BaseLayout>
