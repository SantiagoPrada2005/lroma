import BaseLayout from "@/layouts/BaseLayout.astro";
import CinematicHero from "@/components/home/CinematicHero.astro";
import ScrollGallery from "@/components/home/ScrollGallery.astro";
import GlassFeatureCards from "@/components/home/GlassFeatureCards.astro";
import StatsCounter from "@/components/home/StatsCounter";
import ReservationCTA from "@/components/home/ReservationCTA.astro";
---

<BaseLayout
