---
// Gallery page — L'Roma Pizza & Grill
// 3D infinite gallery with WebGL cloth-effect planes
import BaseLayout from "@/layouts/BaseLayout.astro";
import InfiniteGallery from "@/components/ui/3d-gallery-photography";
import { SITE_IMAGES } from "@/config/images";
---

<BaseLayout
  title="Galería"
  description="L'Roma Pizza & Grill — Nuestra cocina, ambiente y momentos capturados en imágenes."
>
  <div class="relative h-screen w-full overflow-hidden bg-[#0A0A0A]">
    <!-- 3D Infinite Gallery -->
    <InfiniteGallery
      client:load
      images={SITE_IMAGES.infiniteGallery}
      speed={1}
      visibleCount={8}
      className="h-screen w-full"
    />

    <!-- Overlay: L'Roma branding — positioned above canvas -->
    <div class="pointer-events-none absolute inset-0 z-10 flex flex-col items-center justify-center">
      <span class="mb-3 inline-block rounded-full border border-lroma-gold/30 px-3 py-1 font-sans text-[10px] font-medium uppercase tracking-[0.2em] text-lroma-gold backdrop-blur-sm">
        Galería
      </span>
      <h1 class="font-heading text-4xl tracking-tight text-white md:text-7xl">
        L'Roma
      </h1>
    </div>

    <!-- Navigation hints -->
    <div class="pointer-events-none absolute bottom-10 left-0 right-0 z-10 text-center font-sans text-[11px] font-semibold uppercase text-white/30">
      <p>Rueda del mouse · flechas · touch</p>
    </div>
  </div>
</BaseLayout>
