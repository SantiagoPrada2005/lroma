---
// Gallery page — L'Roma Pizza & Grill
// 3D infinite gallery with WebGL cloth-effect planes
import BaseLayout from "@/layouts/BaseLayout.astro";
import InfiniteGallery from "@/components/ui/3d-gallery-photography";
---

<BaseLayout
  title="Galería"
  description="L'Roma Pizza & Grill — Nuestra cocina, ambiente y momentos capturados en imágenes."
>
  <main class="relative h-screen w-full">
    <!-- 3D Infinite Gallery -->
    <InfiniteGallery
      client:load
      images={[
        { src: "https://images.unsplash.com/photo-1513104890138-7c749659a591?w=600&auto=format&fit=crop&q=80", alt: "Pizza artesanal" },
        { src: "https://images.unsplash.com/photo-1544025162-d76694265947?w=600&auto=format&fit=crop&q=80", alt: "Grill premium" },
        { src: "https://images.unsplash.com/photo-1612874742237-6526221588e3?w=600&auto=format&fit=crop&q=80", alt: "Pasta fresca" },
        { src: "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=600&auto=format&fit=crop&q=80", alt: "Hamburguesa" },
        { src: "https://images.unsplash.com/photo-1574071318508-1cdbab80d002?w=600&auto=format&fit=crop&q=80", alt: "Pizza napolitana" },
        { src: "https://images.unsplash.com/photo-1625938145744-e380515399b7?w=600&auto=format&fit=crop&q=80", alt: "Picada" },
        { src: "https://images.unsplash.com/photo-1574894709920-11b28e7367e3?w=600&auto=format&fit=crop&q=80", alt: "Lasaña" },
        { src: "https://images.unsplash.com/photo-1558030006-450675393462?w=600&auto=format&fit=crop&q=80", alt: "Cocina" },
        { src: "https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=600&auto=format&fit=crop&q=80", alt: "Carne" },
        { src: "https://images.unsplash.com/photo-1467003909585-2f8a72700288?w=600&auto=format&fit=crop&q=80", alt: "Chef" },
        { src: "https://images.unsplash.com/photo-1600891964092-4316c288032e?w=600&auto=format&fit=crop&q=80", alt: "Grill" },
        { src: "https://images.unsplash.com/photo-1484723091739-30a097e8f929?w=600&auto=format&fit=crop&q=80", alt: "Postre" },
      ]}
      speed={1.2}
      visibleCount={12}
      className="h-screen w-full"
    />

    <!-- Overlay: L'Roma branding -->
    <div class="pointer-events-none fixed inset-0 z-10 flex items-center justify-center px-3 text-center mix-blend-exclusion">
      <h1 class="font-heading text-4xl tracking-tight text-white md:text-7xl">
        <span class="italic">L'Roma</span>
      </h1>
    </div>

    <!-- Navigation hints -->
    <div class="pointer-events-none fixed bottom-10 left-0 right-0 z-10 text-center font-sans text-[11px] font-semibold uppercase">
      <p class="text-white/50">Usá la rueda del mouse, flechas o touch para navegar</p>
      <p class="text-white/30">Auto-play después de 3 segundos sin interacción</p>
    </div>
  </main>
</BaseLayout>
