---
// BaseLayout — Dark luxury shell for all pages
// Semantic HTML landmarks, meta/OG tags, font preloading
import { ClientRouter } from "astro:transitions";
import FloatingNav from "@/components/global/FloatingNav";
import Footer from "@/components/global/Footer.astro";
import "@/styles/globals.css";
import "@/styles/fonts.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "L'Roma Pizza & Grill — Pizza artesanal, parrilla y cocina de autor en un ambiente cálido y sofisticado.",
  image = `${import.meta.env.BASE_URL}img/lroma-front.webp`,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}img/logo.ico`} />
    <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}img/logo.ico`} />
    <link rel="icon" type="image/webp" href={`${import.meta.env.BASE_URL}img/logo.webp`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}img/logo.webp`} />

    <!-- Primary Meta -->
    <title>{title} | L'Roma Pizza & Grill</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | L'Roma Pizza & Grill`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="L'Roma Pizza & Grill" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | L'Roma Pizza & Grill`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Client-side navigation with View Transitions -->
    <ClientRouter />
  </head>
  <body>
    <!-- Skip to content — accessibility -->
    <a href="#main-content" class="skip-to-content">
      Saltar al contenido
    </a>

    <!-- Floating Navigation — React island, client:load -->
    <header id="site-header">
      <FloatingNav client:load />
    </header>

    <!-- Main content slot -->
    <main id="main-content" data-astro-transition-scope="main">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
