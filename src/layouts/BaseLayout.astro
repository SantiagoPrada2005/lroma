---
// BaseLayout — Dark luxury shell for all pages
// Semantic HTML landmarks, meta/OG tags, font preloading
import FloatingNav from "@/components/global/FloatingNav";
import Footer from "@/components/global/Footer.astro";
import "@/styles/globals.css";
import "@/styles/fonts.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "L'Roma Pizza & Grill — Pizza artesanal, parrilla y cocina de autor en un ambiente cálido y sofisticado.",
  image = "/assets/images/og-default.jpg",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{title} | L'Roma Pizza & Grill</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | L'Roma Pizza & Grill`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="L'Roma Pizza & Grill" />

    <!-- Preload critical fonts -->
    <link
      rel="preload"
      href="/_astro/fonts/playfair-display-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Font preload for critical path -->

  </head>
  <body>
    <!-- Skip to content — accessibility -->
    <a href="#main-content" class="skip-to-content">
      Saltar al contenido
    </a>

    <!-- Floating Navigation — React island, client:load -->
    <header id="site-header">
      <FloatingNav client:load />
    </header>

    <!-- Main content slot -->
    <main id="main-content" data-astro-transition-scope="main">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
